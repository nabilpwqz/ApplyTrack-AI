// Prisma Schema for ApplyTrack AI Studio
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         String   @default("USER") // USER | ADMIN
  provider     String   @default("email") // email | google | guest
  plan         String   @default("free")  // free | premium
  status       String   @default("active") // active | suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications        Application[]
  emailImports        EmailImport[]
  careerGoals         CareerGoal[]
  networkContacts     NetworkContact[]
  stories             Story[]
  briefNotes          BriefNote[]
  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]

  @@map("users")
}

model Application {
  id              Int      @id @default(autoincrement())
  userId          String?
  company         String
  title           String
  url             String?
  location        String?
  workMode        String?  // Remote | Hybrid | On-site
  employmentType  String?  // Full-time | Part-time | Contract | Internship | Freelance
  salaryMin       Int?     @default(0)
  salaryMax       Int?     @default(0)
  applicationDate String?
  deadline        String?
  source          String?  // LinkedIn | Indeed | Company Website | Referral | Job Board | Recruiter | Other
  priority        String   @default("Medium") // High | Medium | Low
  status          String   @default("saved")  // saved | applied | screening | assessment | interview | final_interview | offer | accepted | rejected | withdrawn
  notes           String?
  recruiterName   String?
  recruiterEmail  String?
  resumeVersion   String?
  tags            String[] @default([])
  interviewPrep   String?  // JSON string storing checkbox states
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeline TimelineEvent[]

  @@map("applications")
}

model TimelineEvent {
  id            String   @id @default(cuid())
  applicationId Int
  date          String
  event         String
  type          String   // submitted | contact | screening | assessment | interview | final | rejected | withdrawn | saved
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("timeline_events")
}

model EmailImport {
  id           Int      @id @default(autoincrement())
  userId       String?
  company      String
  title        String
  source       String   @default("email")
  status       String   @default("pending") // pending | imported | dismissed
  detectedDate String
  confidence   String   // High | Medium | Low
  emailSubject String
  extractData  String   // JSON string of detected fields
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_imports")
}

model CareerGoal {
  id                 String   @id @default(cuid())
  userId             String?
  weeklyApplications Int      @default(5)
  weeklyInterviews   Int      @default(2)
  targetRole         String?  @default("")
  targetDate         String?  @default("")
  notes              String?  @default("")
  streak             Int      @default(0)
  lastWeekKey        String?  @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_goals")
}

model NetworkContact {
  id        Int      @id @default(autoincrement())
  userId    String?
  name      String
  role      String   // Recruiter | Hiring manager | Referral | Peer
  company   String
  email     String?
  notes     String?
  lastTouch String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("network_contacts")
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    String?
  title     String
  tags      String[] @default([])
  situation String?
  task      String?
  action    String?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stories")
}

model BriefNote {
  id        String   @id @default(cuid())
  userId    String?
  text      String
  date      String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brief_notes")
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String?
  plan          String    @default("free") // free | premium
  status        String    @default("free") // free | pending | approved
  requestedPlan String?
  method        String    @default("International payment")
  amount        String?   @default("19.00")
  currency      String?   @default("USD")
  requestedAt   DateTime?
  approvedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model BillingTransaction {
  id        String   @id @default(cuid())
  userId    String?
  txnId     String   @unique
  time      String
  method    String
  gateway   String
  amount    String
  currency  String
  status    String   @default("success")
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_transactions")
}
